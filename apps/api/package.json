{
  "name": "@horse-asset-manager/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "build": "wrangler deploy --dry-run --env= --outdir dist",
    "deploy:dev": "wrangler deploy --env dev",
    "db:migrate:local": "wrangler d1 migrations apply horse_asset_manager_local --local",
    "db:seed:local": "wrangler d1 execute horse_asset_manager_local --local --file ../../scripts/seed-local.sql",
    "db:migrate:dev": "wrangler d1 migrations apply horse_asset_manager_dev --remote --env dev",
    "typecheck": "tsc --pretty false"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@horse-asset-manager/database": "^0.1.0",
    "@horse-asset-manager/shared": "^0.1.0",
    "@horse-asset-manager/validation": "^0.1.0",
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "wrangler": "^4.120.0"
  }
}
